{
    "name": "lead-scraper-backend",
    "version": "1.0.0",
    "description": "Lead scraping platform with Node.js, Knex and MySQL",
    "main": "src/app.js",
    "type": "commonjs",
    "scripts": {
        "dev": "node src/app.js",
        "start": "NODE_ENV=production node src/app.js",
        "migrate:latest": "knex migrate:latest",
        "migrate:rollback": "knex migrate:rollback",
        "migrate:make": "knex migrate:make",
        "scrape:manual": "node scripts/scrape.js",
        "enrich:email": "node scripts/enrich-leads-email.js",
        "engagement:recalculate": "node scripts/recalculate-engagement.js",
        "email:test-mailersend": "node scripts/test-mailersend.js",
        "test": "jest --runInBand",
        "lint": "eslint src scripts"
    },
    "dependencies": {
        "axios": "^1.7.7",
        "cheerio": "^1.0.0",
        "dotenv": "^16.4.5",
        "duck-duck-scrape": "^2.2.7",
        "express": "^4.21.0",
        "google-it": "^1.6.4",
        "helmet": "^8.0.0",
        "joi": "^17.13.3",
        "knex": "^3.1.0",
        "libphonenumber-js": "^1.11.12",
        "mysql2": "^3.11.3",
        "nodemailer": "^8.0.7",
        "pdf-parse": "^1.1.1",
        "pino": "^9.4.0",
        "pino-http": "^10.3.0",
        "puppeteer": "^23.4.1"
    },
    "devDependencies": {
        "eslint": "^9.12.0",
        "jest": "^29.7.0",
        "supertest": "^7.2.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
